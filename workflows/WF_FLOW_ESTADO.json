{
  "name": "WF_FLOW_ESTADO",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.estado_fsm }}",
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value2": "TRACK_ORDER",
              "output": 0
            }
          ]
        },
        "fallbackOutput": 1
      },
      "id": "router",
      "name": "Estado Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "",
          "mode": "id"
        }
      },
      "id": "read-order",
      "name": "Read Order",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        650,
        150
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.id_pedido || '' }}",
              "operation": "notEqual",
              "value2": ""
            },
            {
              "value1": "={{ $json.telegram_id || '' }}",
              "value2": "={{ $('Execute Workflow Trigger').first().json.telegram_id }}"
            }
          ]
        },
        "combineOperation": "all"
      },
      "id": "check-exists",
      "name": "Check Order Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "const order = $input.first().json;\nconst emojis = {\n  'RECIBIDO': '\ud83d\udce6',\n  'PREPARACION': '\ud83d\udd25',\n  'EN_CAMINO': '\ud83d\ude9a',\n  'LISTO': '\u2705',\n  'ENTREGADO': '\ud83c\udf89',\n  'CANCELADO': '\u274c'\n};\nconst emoji = emojis[order.estado] || '\ud83d\udce6';\nreturn [{\n  json: {\n    nuevo_estado: 'MENU_PRINCIPAL',\n    mensaje: `\ud83d\udccd *Estado de tu pedido*\\n\\n\ud83d\udce6 Orden: #${order.id_pedido}\\n\\nEstado: ${emoji} ${order.estado}`,\n    reply_markup: {\n      inline_keyboard: [\n        [{ text: '\u2b05\ufe0f Men\u00fa Principal', callback_data: 'action_back_main' }]\n      ]\n    },\n    session_updates: {\n      estado_fsm: 'MENU_PRINCIPAL',\n      carrito_json: '[]',\n      contexto_json: '{}'\n    }\n  }\n}];"
      },
      "id": "format-found",
      "name": "Format Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        50
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst inputId = $('Execute Workflow Trigger').first().json.text || 'desconocida';\nreturn [{\n  json: {\n    nuevo_estado: 'MENU_PRINCIPAL',\n    mensaje: `\u274c Lo sentimos, no encontramos ninguna orden tuya con el c\u00f3digo \"${inputId}\".\\n\\nAseg\u00farate de haber escrito el c\u00f3digo correctamente (ejemplo: ORD-20260604-0001) y que la orden te pertenezca.`,\n    reply_markup: {\n      inline_keyboard: [\n        [{ text: '\u2b05\ufe0f Men\u00fa Principal', callback_data: 'action_back_main' }]\n      ]\n    },\n    session_updates: {\n      estado_fsm: 'MENU_PRINCIPAL',\n      carrito_json: '[]',\n      contexto_json: '{}'\n    }\n  }\n}];\n"
      },
      "id": "format-not-found",
      "name": "Format Not Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        250
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Estado Router",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Estado Router": {
      "main": [
        [
          {
            "node": "Read Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Order": {
      "main": [
        [
          {
            "node": "Check Order Exists",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Order Exists": {
      "main": [
        [
          {
            "node": "Format Found",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Not Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}