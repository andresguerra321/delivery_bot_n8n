    {
      "parameters": {
        "jsCode": "const menuItems = $('Read Menu').all().map(i => i.json);\nconst calc = $('Validate & Calculate').first().json;\nlet cart = [];\ntry { cart = JSON.parse(calc.carrito_json || '[]'); } catch(e) {}\n\nconst results = [];\nfor (const cartItem of cart) {\n  const menuItem = menuItems.find(m => m.id_producto === cartItem.id);\n  if (menuItem) {\n    results.push({\n      json: {\n        id_producto: cartItem.id,\n        stock: (parseInt(menuItem.stock) - cartItem.qty).toString()\n      }\n    });\n  }\n}\nreturn results.length > 0 ? results : [{ json: { id_producto: 'none', stock: '0' } }];"
      },
