        "jsCode": "const calc = $('Validate & Calculate').first().json;\nreturn [{\n  json: {\n    mensaje: '✅ *¡Pedido confirmado!*\\n\\n📦 Orden: #' + calc.id_pedido + '\\n💰 Subtotal: $' + calc.subtotal.toFixed(2) + '\\n📊 IVA (12%): $' + calc.iva.toFixed(2) + '\\n💵 Total: $' + calc.total_pago.toFixed(2) + '\\n📍 Estado: Recibido\\n\\nTe notificaremos cuando esté en preparación. 🍳',\n    reply_markup: { inline_keyboard: [[{ text: '🏠 Menú Principal', callback_data: 'main_menu' }]] },\n    session_updates: { estado_fsm: 'IDLE', carrito_json: '[]', contexto_json: '{}' }\n  }\n}];"
