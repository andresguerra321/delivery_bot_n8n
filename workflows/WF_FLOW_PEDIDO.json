      "id": "p-read-menu",
      "name": "Read Menu",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "15AvKlr14Qt1VZsU",
          "name": "Google Sheets account"
