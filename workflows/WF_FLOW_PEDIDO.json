    {
      "parameters": {
        "jsCode": "const calc = $('Validate & Calculate').first().json;\nconst inputData = $('Execute Workflow Trigger').first().json;\n\nconst text = '🛎 *Nuevo Pedido Recibido*\\n\\n📦 Orden: #' + calc.orderId + '\\n👤 ' + calc.first_name + '\\n📋 ' + calc.detalles + '\\n💵 Total: $' + calc.total.toFixed(2);\n\nconst keyboard = {\n  inline_keyboard: [\n    [\n      { text: '🍳 Preparar', callback_data: 'admin_prep_' + calc.orderId },\n      { text: '❌ Rechazar', callback_data: 'admin_reject_' + calc.orderId }\n    ]\n  ]\n};\n\nreturn [{ json: {\n  chat_id: inputData.chat_id,\n  text: text,\n  parse_mode: 'Markdown',\n  reply_markup: keyboard\n}}];"
      },
