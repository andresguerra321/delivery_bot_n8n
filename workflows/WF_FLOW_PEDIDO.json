    {
      "parameters": {
        "jsCode": "const inputData = $('Execute Workflow Trigger').first().json;\nconst menuItems = $('Read Menu').all().map(i => i.json);\nlet cart = [];\ntry { cart = JSON.parse(inputData.carrito_json || '[]'); } catch(e) {}\n\nconst TAX_RATE = 0.12;\nlet subtotal = 0;\nlet errors = [];\n\nfor (const item of cart) {\n  const menuItem = menuItems.find(m => m.id_producto === item.id);\n  if (!menuItem) {\n    errors.push(item.nombre + ' ya no está disponible');\n    continue;\n  }\n  const stock = parseInt(menuItem.stock);\n  if (stock < item.qty) {\n    errors.push(item.nombre + ': solo quedan ' + stock + ' unidades');\n    continue;\n  }\n  subtotal += item.qty * parseFloat(menuItem.precio);\n}\n\nconst iva = Math.round(subtotal * TAX_RATE * 100) / 100;\nconst total = Math.round((subtotal + iva) * 100) / 100;\n\nconst now = new Date();\nconst dateStr = now.toISOString().slice(0, 10).replace(/-/g, '');\nconst randomNum = Math.floor(1000 + Math.random() * 9000);\nconst orderId = 'ORD-' + dateStr + '-' + randomNum;\nconst detalles = cart.map(i => i.nombre + ' x' + i.qty).join(', ');\n\nreturn [{ json: {\n  valid: errors.length === 0,\n  errors: errors,\n  id_pedido: orderId, subtotal: subtotal, iva: iva, total_pago: total, detalles_pedido: detalles, estado: 'RECIBIDO',\n  \n  telegram_id: inputData.telegram_id,\n  chat_id: inputData.chat_id,\n  first_name: inputData.first_name || 'Usuario',\n  fecha: now.toISOString().split('T')[0],\n  hora: now.toTimeString().split(' ')[0],\n  carrito_json: inputData.carrito_json\n}}];"
      },
