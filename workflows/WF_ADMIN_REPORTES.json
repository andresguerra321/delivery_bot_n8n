    {
      "parameters": {
        "jsCode": "// Filter menu items with low stock\nconst menuItems = $('Read All Menu Items').all();\nconst lowStock = menuItems.filter(item => {\n  const stock = parseInt(item.json.stock || 0);\n  const stockMinimo = parseInt(item.json.stock_minimo || 0);\n  const activo = String(item.json.activo).toUpperCase();\n  return stock <= stockMinimo && (activo === 'TRUE' || activo === 'SI' || activo === '1');\n});\n\nreturn [{\n  json: {\n    low_stock_items: lowStock.map(item => ({\n      nombre: item.json.nombre,\n      stock: parseInt(item.json.stock || 0)\n    }))\n  }\n}];"
      },
      "id": "b1000000-0000-0000-0000-000000000008",
      "name": "Check Low Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format the daily report message\nconst metrics = $('Calculate Metrics').first().json;\nconst lowStockData = $('Check Low Stock').first().json.low_stock_items;\n\nlet lowStockSection = '';\nif (lowStockData && lowStockData.length > 0) {\n  const lines = lowStockData.map(item => `• ${item.nombre}: ${item.stock} restantes`);\n  lowStockSection = `\\n\\n⚠️ *Productos con Stock Bajo:*\\n${lines.join('\\n')}`;\n} else {\n  lowStockSection = '\\n\\n✅ *Stock:* Todos los productos tienen stock suficiente.';\n}\n\nconst report = `📊 *REPORTE DIARIO — ${metrics.fecha}*\\n\\n` +\n  `💰 Total Vendido: $${metrics.total_ventas}\\n` +\n  `📦 Pedidos Completados: ${metrics.num_pedidos}\\n` +\n  `⭐ Producto Estrella: ${metrics.producto_estrella} (${metrics.cantidad_estrella} uds)\\n` +\n  `🕐 Hora Pico: ${metrics.hora_pico}` +\n  lowStockSection +\n  `\\n\\n🕐 _Generado: ${metrics.generado_en}_`;\n\nreturn [{ json: { report } }];"
      },
      "id": "b1000000-0000-0000-0000-000000000009",
      "name": "Format Report",
      "type": "n8n-nodes-base.code",
