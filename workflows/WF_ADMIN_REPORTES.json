    {
      "parameters": {
        "jsCode": "const orders = $('Read Today Orders').all();\nconst details = $('Read Detail Lines').all();\n\n// Total sales\nconst totalVentas = orders.reduce((sum, o) => sum + parseFloat(o.json.total_pago || 0), 0);\nconst numPedidos = orders.length;\n\n// Product star (most sold)\nconst productCount = {};\ndetails.forEach(d => {\n  const name = d.json.nombre;\n  const qty = parseInt(d.json.cantidad || 0);\n  productCount[name] = (productCount[name] || 0) + qty;\n});\nconst sorted = Object.entries(productCount).sort((a, b) => b[1] - a[1]);\nconst productoEstrella = sorted[0] ? sorted[0][0] : 'N/A';\nconst cantidadEstrella = sorted[0] ? sorted[0][1] : 0;\n\n// Peak hour\nconst hourCount = {};\norders.forEach(o => {\n  const hour = (o.json.hora || '00:00').split(':')[0];\n  hourCount[hour] = (hourCount[hour] || 0) + 1;\n});\nconst peakHour = Object.entries(hourCount).sort((a, b) => b[1] - a[1])[0];\nconst horaPico = peakHour ? `${peakHour[0]}:00-${parseInt(peakHour[0]) + 1}:00` : 'N/A';\n\nreturn [{\n  json: {\n    fecha: new Date().toISOString().slice(0, 10),\n    total_ventas: totalVentas.toFixed(2),\n    num_pedidos: numPedidos,\n    producto_estrella: productoEstrella,\n    cantidad_estrella: cantidadEstrella,\n    hora_pico: horaPico,\n    generado_en: new Date().toISOString()\n  }\n}];"
      },
