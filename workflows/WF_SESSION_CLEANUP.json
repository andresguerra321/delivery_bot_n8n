    {
      "parameters": {
        "jsCode": "// Summary: count how many sessions were cleaned\nconst items = $('Filter Expired').all();\nconst cleaned = items.filter(i => i.json.has_expired === true).length;\nconst timestamp = new Date().toISOString();\n\nconsole.log(`[SESSION_CLEANUP] ${timestamp} \u2014 Cleaned ${cleaned} expired sessions`);\n\nreturn [{\n  json: {\n    message: `Session cleanup completed. ${cleaned} expired sessions cleaned.`,\n    cleaned_count: cleaned,\n    timestamp\n  }\n}];"
      },
