      "id": "c1000000-0000-0000-0000-000000000006",
      "name": "Check Cart",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse cart items for stock restoration\nconst carritoRaw = $json.carrito_json || '[]';\nconst telegramId = $json.telegram_id;\nlet carrito;\ntry {\n  carrito = JSON.parse(carritoRaw);\n} catch (e) {\n  carrito = [];\n}\n\nif (carrito.length === 0) {\n  return [{ json: { skip: true, telegram_id: telegramId } }];\n}\n\n// Return items with quantities to restore\nreturn carrito.map(item => ({\n  json: {\n    item_id: item.id,\n    nombre: item.nombre,\n    cantidad_a_restaurar: item.cantidad || item.qty || 1,\n    telegram_id: telegramId\n  }\n}));"
      },
