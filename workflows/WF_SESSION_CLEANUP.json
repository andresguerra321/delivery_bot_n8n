      "id": "c1000000-0000-0000-0000-000000000002",
      "name": "Read All Sessions",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const sessions = $input.all();\nconst now = Date.now();\nconst TTL = 30 * 60 * 1000; // 30 minutes\n\nconst expired = sessions.filter(s => {\n  const lastChange = new Date(s.json.ultimo_cambio).getTime();\n  const estado = s.json.estado_fsm || '';\n  return (now - lastChange > TTL) &&\n    estado !== 'IDLE' &&\n    estado !== 'ENTREGADO' &&\n    estado !== '';\n});\n\nif (expired.length === 0) {\n  return [{ json: { count: 0, has_expired: false } }];\n}\n\nreturn expired.map(s => ({ json: { ...s.json, has_expired: true } }));"
      },
      "id": "c1000000-0000-0000-0000-000000000003",
      "name": "Filter Expired",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-expired",
              "leftValue": "={{ $json.has_expired }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c1000000-0000-0000-0000-000000000004",
      "name": "Check If Any Expired",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
