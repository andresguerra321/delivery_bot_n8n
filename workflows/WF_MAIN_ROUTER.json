    {
      "parameters": {
        "jsCode": "const extractData = $('Extract Data').first().json;\nconst sessionData = $input.first().json;\nconst cb = extractData.callback_data || '';\nconst text = extractData.text || '';\n\n// Ignorar callbacks del admin panel - los maneja WF_ADMIN_PANEL\nif (cb.startsWith('admin_')) {\n  return [];\n}\n\nlet estado = sessionData.estado_fsm || 'MENU_PRINCIPAL';\n\nif (cb !== '') {\n  if (cb.startsWith('cat_') || cb.startsWith('add_') || cb.startsWith('qty_') || cb === 'main_menu' || cb === 'back_menu' || cb === 'cat_ver_todas' || cb === 'cart_ver_historial' || cb === 'confirm_track') {\n    estado = 'MENU_PRINCIPAL';\n  } else if (cb === 'view_cart' || cb === 'confirm_yes') {\n    estado = 'CARRITO';\n  } else if (cb === 'final_confirm') {\n    estado = 'CONFIRM_ORDER';\n  }\n}\n\nif (text === '/start') {\n  estado = 'MENU_PRINCIPAL';\n}\n\nreturn [{ json: { ...sessionData, estado_fsm: estado } }];\n"
      },
