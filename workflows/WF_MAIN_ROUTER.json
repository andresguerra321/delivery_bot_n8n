    {
      "parameters": {
        "jsCode": "const chatId = $('Extract Data').first().json.chat_id;\nconst subworkflows = [\n  \"Call 'WF_FLOW_MENU'\",\n  \"Call 'WF_FLOW_ESTADO'\",\n  \"Call 'WF_FLOW_PEDIDO'\",\n  \"Call 'WF_FLOW_CARRITO\"\n];\nlet mensaje = 'Ocurri\\u00f3 un error. Escribe /start para reiniciar.';\nlet replyMarkup = {};\nlet sessionUpdates = { estado_fsm: 'MENU_PRINCIPAL', carrito_json: '[]', contexto_json: '{}' };\n\nfor (const sw of subworkflows) {\n  try {\n    const data = $(sw).first();\n    if (data && data.json && data.json.mensaje) {\n      mensaje = data.json.mensaje;\n      replyMarkup = data.json.reply_markup || {};\n      sessionUpdates = data.json.session_updates || sessionUpdates;\n      break;\n    }\n  } catch(e) { continue; }\n}\n\nreturn [{ json: { chat_id: chatId, text: mensaje, reply_markup: replyMarkup, session_updates: sessionUpdates } }];\n"
      },
      "id": "64868f78-b912-48d7-870f-eb8aef8a2532",
      "name": "Prepare Telegram Payload",
