        "url": "https://api.telegram.org/bot8960050493:AAEvGqqtGGvIjdHDf1fL6rYoMU4ZVRMKYyI/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text, reply_markup: $json.reply_markup, parse_mode: 'Markdown' }) }}",
        "options": {
