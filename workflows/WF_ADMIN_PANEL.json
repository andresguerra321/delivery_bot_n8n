      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "Check Admin Callback",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse admin callback data\n// Format: admin_{action}_{orderId}\n// e.g. admin_prep_ORD-20260604-0042\nconst callbackData = $('Telegram Trigger').first().json.callback_query.data;\nconst chatId = $('Telegram Trigger').first().json.callback_query.message.chat.id;\nconst messageId = $('Telegram Trigger').first().json.callback_query.message.message_id;\nconst parts = callbackData.split('_');\n\n// parts[0] = 'admin'\n// parts[1] = action (prep, enroute, delivered, reject)\n// parts[2..] = orderId (may contain underscores, so rejoin)\nconst action = parts[1];\nconst orderId = parts.slice(2).join('_');\n\nreturn [{\n  json: {\n    action,\n    orderId,\n    chatId,\n    messageId,\n    callbackData\n  }\n}];"
      },
