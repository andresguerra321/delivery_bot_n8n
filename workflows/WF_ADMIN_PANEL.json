    {
      "parameters": {
        "jsCode": "// Restore stock for rejected order\nconst order = $('Read Order - Reject').first().json;\nconst carritoRaw = order.carrito_json || '[]';\nlet carrito;\ntry {\n  carrito = JSON.parse(carritoRaw);\n} catch (e) {\n  carrito = [];\n}\n\n// Output each item to restore\nconst results = carrito.map(item => ({\n  json: {\n    id: item.id,\n    nombre: item.nombre,\n    cantidad_a_restaurar: item.cantidad || item.qty || 1\n  }\n}));\n\nreturn results.length > 0 ? results : [{ json: { skip: true } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000042",
